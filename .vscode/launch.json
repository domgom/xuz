{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "xuz (remote, dlv in terminal)",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "remotePath": "${workspaceFolder}",
            "port": 40000
        },
        {
            "name": "xuz --dry-run",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/xuz",
            "args": ["--dry-run"],
            "console": "integratedTerminal"
        }
    ]
}
